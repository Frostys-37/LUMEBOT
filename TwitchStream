const { ApplicationCommandOptionType, ButtonStyle } = require(`discord.js`)
const Discord = require(`discord.js`);
const emojis = require(`./src/emojis.json`)

module.exports = {
    name: `ready`,
  
    run: async (client) => {
        
        setInterval(async function(){

        const user = "ElSpreen" || ""

        const fetch = require("node-superfetch")

        const title = await fetch.get(`https://decapi.me/twitch/title/${user}`)
        const avatar = await fetch.get(`https://decapi.me/twitch/avatar/${user}`)
        const follows = await fetch.get(`https://decapi.me/twitch/followcount/${user}`)
        const game = await fetch.get(`https://decapi.me/twitch/game/${user}`)
        const viewers = await fetch.get(`https://decapi.me/twitch/viewercount/${user}`)
        const uptime = await fetch.get(`https://decapi.me/twitch/uptime/${user}`)

        if(uptime.body !== `${user} is offline`){

        const embed = new Discord.EmbedBuilder()
        .setAuthor({ name: `${user}`, iconURL: `${avatar.body}` })
        .setTitle(`${user} está en vivo!`)
        .setThumbnail(`${avatar.body}`)
        .addFields(
            { name: "Jugando a:", value: `${game.body}`, inline: true},
            { name: "Viewers:", value: `${viewers.body}`, inline: true },
            { name: "Seguidores:", value: `${follows.body}`, inline: true },
            { name: "Stream URL:", value: `**https://www.twitch.tv/${user}**`, inline: true}
        )
        .setDescription(`${title.body}`)
        .setColor("Purple")
        .setImage(`https://static-cdn.jtvnw.net/previews-ttv/live_user_${user}-1920x1080.jpg`)
        .setTimestamp()
        
        await client.channels.cache.get("1065322630980321422").send({ embeds: [embed] })
        }
    }, 7200000)
        }
    }